APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
CORS_ORIGINS=capacitor://localhost,http://localhost

# Internal API maintenance secret; admin web login uses admin_users instead.
ADMIN_TOKEN=replace-with-a-long-random-token
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# The application always connects to MySQL, including when testing from a
# local browser. Leave DATABASE_URL empty and use the remote MYSQL_* settings.
DATABASE_URL=
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aiaimage
MYSQL_CONNECTION_LIMIT=10

# Image and vision providers come from the database (model_configs), not from
# this file. Add a row in the admin console and mark it default.
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_BYTES=10485760
MAX_STYLES=4

# Vendor failover. Every enabled image_generation row in model_configs is a
# standby line; the default row leads. A line is skipped for
# PROVIDER_COOLDOWN_SECONDS after PROVIDER_FAILURE_THRESHOLD consecutive
# vendor-side failures. Keep the threshold low: each style in a request
# contributes only one failure, so a high value lets several styles burn the
# full retry budget on a dead line before the standby is used.
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=60
# Re-entering a failed job. Attempts are counted per job, not per image.
MAX_GENERATION_ATTEMPTS=3

ENTITLEMENT_TTL_HOURS=24
SHARE_EXPIRY_HOURS=24
PUBLIC_BASE_URL=http://127.0.0.1:8787

ASSET_DIRECTORY=data/assets
SHARE_DIRECTORY=data/shares
STORAGE_MIN_FREE_BYTES=536870912
STATIC_DIRECTORY=dist
PUBLIC_DIRECTORY=public
LOG_LEVEL=info
LOG_FILE=logs/generation.log
LOG_RETENTION_DAYS=14

# GPT Image compatible provider
GPT_IMAGE_BASE_URL=https://your-image-api.example/v1
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_ENDPOINT=/images/edits
GPT_IMAGE_SIZE=1024x1536
GPT_IMAGE_RESPONSE_FORMAT=b64_json

# Volcengine Ark Seedream
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_SEEDREAM_MODEL=
ARK_IMAGE_ENDPOINT=/images/generations
ARK_IMAGE_SIZE=1024x1536
ARK_RESPONSE_FORMAT=b64_json
ARK_WATERMARK=false

# Jimeng image-to-image
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
JIMENG_BASE_URL=https://visual.volcengineapi.com
JIMENG_REQ_KEY=jimeng_i2i_v30
JIMENG_SCALE=0.5
JIMENG_WIDTH=1024
JIMENG_HEIGHT=1536
JIMENG_POLL_INTERVAL_MS=2000
JIMENG_POLL_TIMEOUT_MS=300000

# Gemini image edit
GEMINI_IMAGE_BASE_URL=https://your-image-api.example/v1
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENDPOINT=/chat/completions
