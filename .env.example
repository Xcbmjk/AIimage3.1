AI_PROVIDER=mock
VITE_GENERATION_MODE=mock
API_PORT=8787
ADMIN_TOKEN=请替换为后台管理密钥
ADMIN_SESSION_SECRET=请替换为独立的后台会话密钥
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aiimage
MYSQL_CONNECTION_LIMIT=10
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_INPUT_BYTES=10485760
MAX_STYLES=4
LOG_LEVEL=info
LOG_FILE=logs/generation.log
LOG_RETENTION_DAYS=14

# Payment: use mock until the WeChat Pay merchant account is ready.
PAYMENT_MODE=mock
PAYMENT_AMOUNT_FEN=990
PAYMENT_DESCRIPTION=山境造像 AI 旅拍体验
PAYMENT_ORDER_FILE=data/payment-orders.json
# 正式环境填写公网 HTTPS 域名；本地留空或使用回环地址时会自动生成局域网地址。
PUBLIC_BASE_URL=http://127.0.0.1:8787
SHARE_DIRECTORY=data/shares
SHARE_EXPIRY_HOURS=24

# WeChat Pay API v3 Native payment (server-side only)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=secrets/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=secrets/wechatpay_public_key.pem

# GPT Image 2 (OpenAI Images API compatible)
GPT_IMAGE_BASE_URL=https://your-image-api.example/v1
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_ENDPOINT=/images/edits
GPT_IMAGE_SIZE=1024x1536
GPT_IMAGE_RESPONSE_FORMAT=b64_json

# Volcengine Ark Seedream
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_SEEDREAM_MODEL=
ARK_IMAGE_ENDPOINT=/images/generations
ARK_IMAGE_SIZE=1024x1536
ARK_RESPONSE_FORMAT=b64_json
ARK_WATERMARK=false

# Jimeng image-to-image 3.0 (Volcengine Visual OpenAPI)
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
JIMENG_BASE_URL=https://visual.volcengineapi.com
JIMENG_REQ_KEY=jimeng_i2i_v30
JIMENG_SCALE=0.5
JIMENG_WIDTH=1024
JIMENG_HEIGHT=1536
JIMENG_POLL_INTERVAL_MS=2000
JIMENG_POLL_TIMEOUT_MS=300000

# Gemini image edit through an OpenAI-compatible chat gateway (server-side only)
GEMINI_IMAGE_BASE_URL=https://deepcoding.sbs/v1
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_ENDPOINT=/chat/completions

# Vision model for Agent mode dynamic prompt analysis (server-side only, OpenAI-compatible chat/completions).
# 仅当启用 Agent 智能生图（AI_PROVIDER=gemini-3.1-flash-image）时必填；AI_PROVIDER=mock 时可留空，服务端使用回退提示词。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_ENDPOINT=/chat/completions
VISION_REQUEST_TIMEOUT_MS=60000
