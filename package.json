{
  "name": "shan-jing-ai-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "server:dev": "npm ci --include=dev && npm run dev",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && node -e \"require('node:fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'commonjs'}))\" && vite build",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:import-json": "tsx server/db/importLegacy.ts",
    "preview": "vite preview",
    "test:gpt-image-2": "tsx scripts/test-gpt-image-2.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.31.0",
    "mysql2": "3.24.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
