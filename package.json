{
  "name": "shan-jing-ai-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && node -e \"require('node:fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'commonjs'}))\" && vite build",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:import-json": "tsx server/db/importLegacy.ts",
    "preview": "vite preview",
    "test:gpt-image-2": "tsx scripts/test-gpt-image-2.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "mysql2": "^3.24.2",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
